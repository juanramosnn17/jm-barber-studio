# =====================================================================
# VARIABLES DE ENTORNO — SUPABASE (Ejemplo)
# ---------------------------------------------------------------------
# Para conectar tu proyecto con Supabase:
# 1. Crea un proyecto en https://supabase.com
# 2. Ve a Configuración del Proyecto -> API (Project Settings -> API).
# 3. Copia la URL del proyecto y la Anon Key (clave pública).
# 4. Crea un archivo llamado `.env.local` en esta misma carpeta y pega estos valores:
# =====================================================================

# DATOS DE SUPABASE: URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# DATOS DE SUPABASE: Clave anónima pública (segura para usar en el navegador con RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# =====================================================================
# BACKEND SPRING BOOT (tarea 4.9)
# ---------------------------------------------------------------------
# Si se define, la app usa la API REST de backend/ (tiene prioridad sobre
# Supabase). Es una variable SOLO del servidor: no lleva NEXT_PUBLIC_.
# Levanta la API con:  cd backend && ./mvnw spring-boot:run
# =====================================================================
API_URL=http://localhost:8080
