# Copia este archivo como backend/.env y pon tus valores reales.
# backend/.env NO se sube a git (está en backend/.gitignore).

# Base principal de la app
DB_URL=jdbc:mysql://localhost:3306/jm_barber?serverTimezone=America/Bogota
DB_USER=jm_app
DB_PASSWORD=cambia-esta-contrasena

# Base separada para las pruebas automáticas (se crea vacía; Flyway la llena)
DB_TEST_URL=jdbc:mysql://localhost:3306/jm_barber_test?serverTimezone=America/Bogota

# Secreto para firmar los tokens JWT (tarea 4.3): mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
